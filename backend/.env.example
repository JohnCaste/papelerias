# Copia este archivo a .env y llena los valores reales -- .env nunca se
# commitea (ya esta en .gitignore). Ver autentificacion/serviciosCloud.py.

# Opcion A (desarrollo local): ruta a la llave de la cuenta de servicio
# de GCP, como archivo .json guardado FUERA del repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Opcion B (CI / hosts sin filesystem persistente): el JSON completo de
# la llave, como una sola linea de texto. Usar A o B, nunca las dos.
# GCP_SERVICE_ACCOUNT_JSON=

# Opcional -- si no se define, se toma del 'project_id' que ya trae la
# llave de servicio.
GCP_PROJECT_ID=

# Nombre del bucket de Google Cloud Storage donde se guardan las
# imagenes de producto (convertidas a .webp). La cuenta de servicio de
# arriba necesita rol storage.objectAdmin sobre este bucket, y el bucket
# debe tener lectura publica para que las imagenes se vean en el
# catalogo. Ver catalogos/imagenes.py.
BUCKET_IMAGENES_PRODUCTO=

# Llave con la que se firman los tokens de sesion (JWT). Obligatoria en
# produccion -- el backend no arranca sin ella (ver main.py). Generar
# una nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# En desarrollo se puede dejar vacia: main.py usa un valor fijo de solo
# desarrollo. Cambiar este valor invalida las sesiones activas (todos
# tienen que volver a iniciar sesion una vez).
JWT_SECRET_KEY=

# Base de datos (dataset de BigQuery) de ESTA papeleria. Obligatoria en
# produccion -- el backend no arranca sin ella, para no guardar las ventas
# de una sucursal en la base de otra (ver utilidades/sucursal.py).
#   Tienda original:  BQ_DATASET=lapape
#   Otra sucursal:    BQ_DATASET=lapape_<nombre>   (solo letras, numeros y _)
# En desarrollo/tests se puede dejar vacia: se usa `lapape`.
BQ_DATASET=

# Opcional: nombre de la sucursal que se muestra en la barra de arriba.
# Si se deja vacio: "Principal" para `lapape`, o el nombre del dataset.
SUCURSAL_NOMBRE=
